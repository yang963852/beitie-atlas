{
  "name": "beitie-atlas",
  "private": true,
  "version": "1.4.1",
  "description": "Between Steles — a learning library of Chinese calligraphy, its makers and surviving witnesses from antiquity to the present",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run knowledge:build",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run knowledge:build",
    "precheck": "npm run knowledge:build",
    "pretypecheck": "npm run knowledge:compile",
    "pretest": "npm run knowledge:compile",
    "knowledge:build": "npm run knowledge:compile && npm run knowledge:generate && npm run knowledge:package",
    "release": "tsx scripts/release.ts",
    "check:release": "tsx scripts/release.ts --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:data": "tsx scripts/check-data.ts",
    "check:docs": "node scripts/check-board.mjs && node scripts/check-docs.mjs",
    "knowledge:compile": "tsx scripts/knowledge-compile.ts",
    "knowledge:generate": "tsx scripts/knowledge-catalogue.ts",
    "knowledge:migrate": "tsx scripts/knowledge-migrate.ts",
    "contrib:new": "tsx scripts/contrib-new.ts",
    "check:knowledge": "tsx scripts/knowledge-catalogue.ts --check",
    "knowledge:status": "tsx scripts/knowledge-status.ts",
    "knowledge:query": "tsx scripts/knowledge-query.ts",
    "check:status": "tsx scripts/knowledge-status.ts --check",
    "check:interface": "tsx scripts/knowledge-compile.ts --check",
    "check:isolation": "tsx scripts/check-isolation.ts",
    "check:version": "tsx scripts/check-version.ts",
    "check:tag": "tsx scripts/check-version.ts --tag",
    "check:reproducible": "tsx scripts/check-reproducible.ts",
    "knowledge:package": "tsx scripts/knowledge-package.ts",
    "check:map-key": "tsx scripts/check-map-key.ts",
    "test": "vitest run",
    "check": "npm run check:interface && npm run typecheck && npm run check:data && npm run check:knowledge && npm run check:status && npm run check:isolation && npm run check:reproducible && npm run check:version && npm run check:docs && npm run test && npm run knowledge:package && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
