{
  "name": "beitie-atlas",
  "private": true,
  "version": "0.2.0-beta.1",
  "description": "Between Steles — a learning library of Chinese calligraphy, its makers and surviving witnesses from antiquity to the present",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "release": "tsx scripts/release.ts",
    "check:release": "tsx scripts/release.ts --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:data": "tsx scripts/check-data.ts",
    "check:docs": "node scripts/check-board.mjs",
    "knowledge:generate": "tsx scripts/knowledge-catalogue.ts",
    "check:knowledge": "tsx scripts/knowledge-catalogue.ts --check",
    "check:map-key": "tsx scripts/check-map-key.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:data && npm run check:knowledge && npm run check:docs && npm run test && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "yaml": "2.8.4"
  }
}
