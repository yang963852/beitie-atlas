# Copy to `.env.local` and fill in what you need. Never commit real credentials.
#
# IMPORTANT: every VITE_* value is compiled into the browser bundle.
# A Tianditu browser key is therefore public: restrict it by domain and quota
# in the provider console. It is not a secret, and `.env` does not hide it.

# Public browser key for the Tianditu JavaScript API 4.0 (see docs/map-pilot.md).
VITE_TIANDITU_KEY=

# Optional deployment sub-path, for example /beitie-atlas/ for GitHub Pages.
VITE_BASE_PATH=

# Set to 1 to fail data validation when any draft record is present (release gate).
VITE_RELEASE_MODE=0
